# =============================================================================
# Hornbach Scraper Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Proxy Configuration ---
# Supported formats:
#   HTTP:   http://user:pass@host:port
#   SOCKS5: socks5://user:pass@host:port
# The proxy MUST be located in Germany for hornbach.de to work.
PROXY_URL=socks5://user:password@german-proxy-host:1080

# Optional: comma-separated list of proxies for rotation
# PROXY_POOL=socks5://u1:p1@host1:1080,http://u2:p2@host2:8080,socks5://u3:p3@host3:1080

# --- Google Sheets Configuration ---
# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# The ID of the Google Sheet to write data into (from the URL)
# Example URL: https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# The worksheet name inside the spreadsheet (default: Sheet1)
GOOGLE_WORKSHEET_NAME=Products

# --- Scraping Settings ---
# Base URL for Hornbach Germany
HORNBACH_BASE_URL=https://www.hornbach.de

# Delay range (seconds) between requests to avoid detection
MIN_DELAY=2.0
MAX_DELAY=5.0

# Maximum number of pages to scrape per category (0 = unlimited)
MAX_PAGES=0

# Maximum retries on failed requests
MAX_RETRIES=3

# Browser headless mode (true/false) — set false for debugging
HEADLESS=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
